# Optional: Compose provides defaults when these settings are omitted.
COMPOSE_PROJECT_NAME=ripobot
RIPO_BIND_ADDRESS=127.0.0.1
RIPO_HTTP_PORT=8080
# Leave empty to use http://localhost:${RIPO_HTTP_PORT:-8080}.
RIPO_PUBLIC_URL=
# Leave empty to inherit RIPO_PUBLIC_URL.
RIPO_WEBHOOK_PUBLIC_URL=
# For Tailscale Serve, set the HTTPS hostname (without scheme or path).
# Set RIPO_PUBLIC_URL to https:// followed by the same hostname.
# Requires RIPO_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy.
RIPO_HTTPS_HOST=
RIPO_BASE_IMAGE=ghcr.io/riporipoteam-ctrl/ripobot-app:latest
RIPO_LOCAL_IMAGE=ripobot-local:latest
CADDY_IMAGE=caddy:2
# Explicitly empty ENGINES skips npm engine installation.
ENGINES="@anthropic-ai/claude-code @openai/codex"
# Leave empty for <COMPOSE_PROJECT_NAME>_data.
RIPO_DATA_VOLUME=
# Use true only when reusing a volume that already exists.
RIPO_DATA_EXTERNAL=false
