# Server-side only. Never add this value to frontend code or a committed file.
HF_TOKEN=

# Defaults to the same model ID used by the RipoBot Discord source.
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Required before a shared HF_TOKEN can be used by the public web app.
RIPO_ACCESS_CODE=

RIPO_PORT=8788
